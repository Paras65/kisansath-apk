# किसान साथी (Kisan Saathi) - Environment Configuration Example Template
# Duplicate this file as .env and update values for your state/deployment (Zero Code Change)

# 1. 🌾 एप्लिकेशन पहचान व राज्य (Branding & Geography)
VITE_APP_NAME="किसान साथी"
VITE_APP_TAGLINE="फसल से लेकर बिक्री तक सम्पूर्ण समाधान"
VITE_APP_VERSION="1.0.20"
VITE_DEFAULT_LANG="cg"
VITE_STATE_NAME="छत्तीसगढ़"
VITE_DEFAULT_DISTRICT="रायपुर"

# 2. 📱 मोबाइल व ऐप डाउनलोड (Mobile & TWA/APK)
VITE_TWA_PACKAGE_ID="in.co.init65.kisan"
VITE_APK_DOWNLOAD_URL="https://github.com/Paras65/kisansath-apk/releases/latest/download/kisan-saathi.apk"

# 3. 📞 हेल्पलाइन व आपातकालीन संपर्क (Helpline Contacts)
VITE_HELPLINE_PHONE="18001801551"
VITE_HELPLINE_LABEL="1800-180-1551"
VITE_KISAN_CALL_CENTER="1800-180-1551"
VITE_FOOD_DEPT_HELPLINE="1800-233-3663"

# 4. 🏛️ सरकारी पोर्टल्स URL (Government External Portals)
VITE_PORTAL_AGRISTACK_URL="https://cgfr.agristack.gov.in/"
VITE_PORTAL_TOKEN_URL="http://khadya.cg.nic.in/"
VITE_PORTAL_BHUIYAN_URL="https://bhuiyan.cg.nic.in/"
VITE_PORTAL_CREDA_URL="https://creda.cgstate.gov.in/"
VITE_PORTAL_PMKISAN_URL="https://pmkisan.gov.in/"
VITE_PORTAL_PMFBY_URL="https://pmfby.gov.in/"

# 5. 💰 धान उपार्जन व योजना दरें (Paddy Procurement & Scheme Rates)
VITE_PADDY_TOTAL_RATE=3100
VITE_PADDY_MSP_RATE=2300
VITE_PADDY_BONUS_RATE=800
VITE_PADDY_MAX_QUINTALS_PER_ACRE=21
VITE_DIVERSIFICATION_SUBSIDY=15000

# 6. 🗄️ MongoDB डेटाबेस एवं बैकएंड API सेटिंग्स
PORT=5000
NODE_ENV="development"
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.qrqi6.mongodb.net/kisan_saathi?retryWrites=true&w=majority&appName=Cluster0"
VITE_API_BASE_URL="http://localhost:5000/api"
JWT_SECRET="your_strong_jwt_hmac_sha256_secret_key"
ADMIN_SECRET="your_strong_admin_passkey_here"
ADMIN_PIN="your_strong_admin_passkey_here"

# 7. 🌐 सर्वर व डोमेन सेटिंग्स (Canonical Host & Third-Party APIs)
VITE_APP_HOST="https://kisan.init65.co.in"
CLIENT_URL="https://kisan.init65.co.in"
CORS_ORIGIN="https://kisan.init65.co.in"
VITE_WEATHER_API_URL=""
VITE_MANDI_API_URL=""
DATA_GOV_IN_API_KEY="your_data_gov_in_api_key_here"
VITE_AI_VISION_API_URL=""

# 8. ⚙️ एक्सटर्नल एपीआई एंडपॉइंट्स व पैरामीटर्स (Zero-Code Dynamic Configuration)
MANDI_API_BASE_URL="https://api.data.gov.in/resource/"
DATA_GOV_IN_RESOURCE_ID="9ef84268-d588-465a-a308-a864a43d0070"
DATA_GOV_IN_CIBRC_RESOURCE_ID=""
DATA_GOV_IN_SOIL_RESOURCE_ID=""
DATA_GOV_IN_MSP_RESOURCE_ID=""
MANDI_API_LIMIT="60"
MANDI_API_TIMEOUT_MS="8000"
MANDI_STATE_VARIANTS="Chattisgarh,Chhattisgarh"
MANDI_BACKUP_MIRROR_URL="https://mandi-api.onrender.com/api/mandis?state=Chhattisgarh"

GEMINI_MODELS="gemini-3.8-flash,gemini-3.5-flash,gemini-3.5-flash-lite"
GEMINI_API_TIMEOUT_MS="16000"
GEMINI_TEMPERATURE="0.15"

WEATHER_API_BASE_URL="https://api.open-meteo.com/v1/forecast"
WEATHER_API_TIMEOUT_MS="5000"

# 8. 🛠️ डायग्नोस्टिक्स व डिबग मोड (Diagnostics & Debug Mode: Set "true" to enable console & UI debug trace)
VITE_DEBUG_MODE="false"
DEBUG_MODE="false"
