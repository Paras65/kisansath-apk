  },
  "item": [
    {
      "name": "1. 🌾 External Agri & OGD APIs (भारत सरकार)",
      "description": "Direct Open Government Data (data.gov.in) endpoints for live mandi rates, pesticides, soil health, and MSP benchmarks.",
      "item": [
        {
          "name": "Agmarknet Live Mandi Rates (OGD India)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{MANDI_API_BASE_URL}}?api-key={{OGD_API_KEY}}&format=json&offset=0&limit=60&filters%5Bstate%5D=Chhattisgarh",
              "host": ["{{MANDI_API_BASE_URL}}"],
              "query": [
                { "key": "api-key", "value": "{{OGD_API_KEY}}" },
                { "key": "format", "value": "json" },
                { "key": "offset", "value": "0" },
                { "key": "limit", "value": "60" },
                { "key": "filters[state]", "value": "Chhattisgarh" }
              ]
            },
            "description": "Fetches live arrival volume and modal price per quintal across APMCs in Chhattisgarh."
          }
        },
        {
          "name": "Agmarknet Mandi Rates Backup Mirror",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "https://mandi-api.onrender.com/api/mandis?state=Chhattisgarh",
              "protocol": "https",
              "host": ["mandi-api", "onrender", "com"],
              "path": ["api", "mandis"],
              "query": [{ "key": "state", "value": "Chhattisgarh" }]
            },
            "description": "High-availability backup mirror proxy when data.gov.in government servers experience downtime."
          }
        },
        {
          "name": "CIB&RC Registered Pesticides (OGD Dataset)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{MANDI_API_BASE_URL}}?api-key={{OGD_API_KEY}}&format=json&offset=0&limit=50",
              "host": ["{{MANDI_API_BASE_URL}}"],
              "query": [
                { "key": "api-key", "value": "{{OGD_API_KEY}}" },
                { "key": "format", "value": "json" },
                { "key": "offset", "value": "0" },
                { "key": "limit", "value": "50" }
              ]
            },
            "description": "Central Insecticides Board approved safe chemical and bio-pesticide formulations."
          }
        },
        {
          "name": "District Soil Health Survey Baseline (OGD Dataset)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{MANDI_API_BASE_URL}}?api-key={{OGD_API_KEY}}&format=json&offset=0&limit=50",
              "host": ["{{MANDI_API_BASE_URL}}"],
              "query": [
                { "key": "api-key", "value": "{{OGD_API_KEY}}" },
                { "key": "format", "value": "json" },
                { "key": "offset", "value": "0" },
                { "key": "limit", "value": "50" }
              ]
            },
            "description": "District-level soil fertility index (N, P, K, pH, Organic Carbon) from the national Soil Health Card scheme."
          }
        },
        {
          "name": "CACP Official MSP Benchmarks (OGD Dataset)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{MANDI_API_BASE_URL}}?api-key={{OGD_API_KEY}}&format=json&offset=0&limit=50",
              "host": ["{{MANDI_API_BASE_URL}}"],
              "query": [
                { "key": "api-key", "value": "{{OGD_API_KEY}}" },
                { "key": "format", "value": "json" },
                { "key": "offset", "value": "0" },
                { "key": "limit", "value": "50" }
              ]
            },
            "description": "Commission for Agricultural Costs and Prices (CACP) official Minimum Support Price benchmarks."
          }
        }
      ]
    },
