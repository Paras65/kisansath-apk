    {
      "name": "3. 🤖 AI Vision Crop Doctor (Google Gemini AI)",
      "description": "Multimodal Computer Vision AI diagnostics for leaf and plant disease identification.",
      "item": [
        {
          "name": "Direct Gemini 2.5 Flash Multimodal Vision API",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"You are an expert Indian agricultural plant pathologist. Analyze this crop leaf image. Identify the crop, exact disease name in Hindi and English, cause, chemical pesticide dosage per 15L pump, organic alternative, and preventive steps in structured JSON.\"\n        },\n        {\n          \"inline_data\": {\n            \"mime_type\": \"image/jpeg\",\n            \"data\": \"/9j/4AAQSkZJRgABAQEASABIAAD... (base64 string)\"\n          }\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"temperature\": 0.15,\n    \"topK\": 32,\n    \"topP\": 0.95,\n    \"maxOutputTokens\": 2048\n  }\n}"
            },
            "url": {
              "raw": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key={{GEMINI_API_KEY}}",
              "protocol": "https",
              "host": ["generativelanguage", "googleapis", "com"],
              "path": ["v1beta", "models", "gemini-2.5-flash:generateContent"],
              "query": [{ "key": "key", "value": "{{GEMINI_API_KEY}}" }]
            },
            "description": "Direct Google Gemini multimodal vision endpoint for plant disease diagnosis."
          }
        },
        {
          "name": "Backend AI Doctor Proxy (/api/crop-doctor/diagnose)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"image\": \"data:image/jpeg;base64,/9j/4AAQSkZJRgABA...\",\n  \"crop\": \"धान\",\n  \"cropId\": \"paddy\",\n  \"symptoms\": \"पत्तियों पर नाव के आकार के भूरे धब्बे दिखाई दे रहे हैं\",\n  \"district\": \"रायपुर\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/crop-doctor/diagnose",
              "host": ["{{BASE_URL}}"],
              "path": ["crop-doctor", "diagnose"]
            },
            "description": "Secure proxy route executing server-side Gemini Vision cascade with sanitized farmer output."
          }
        }
      ]
    },
